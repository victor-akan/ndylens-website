{%- set cat = categories[post.data.category] -%}
<article class="card{% if featured %} card-featured{% endif %}">
  {%- if post.data.featured_image %}
  <a href="{{ post.url }}" class="card-media" tabindex="-1" aria-hidden="true">
    <img src="{{ post.data.featured_image }}" alt="" {% if featured %}loading="eager" fetchpriority="high" sizes="(max-width: 960px) calc(100vw - 36px), 640px"{% else %}sizes="(max-width: 620px) calc(100vw - 36px), (max-width: 960px) 45vw, 380px"{% endif %} />
  </a>
  {%- endif %}
  <div class="card-body">
    <p class="card-meta">{% if cat %}<a href="/blog/category/{{ post.data.category }}/" class="card-cat">{{ cat.name }}</a>{% endif %}<time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time></p>
    <h{{ headingLevel or 3 }} class="card-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h{{ headingLevel or 3 }}>
    {%- if post.data.excerpt %}<p class="card-excerpt">{{ post.data.excerpt }}</p>{% endif %}
    <a href="{{ post.url }}" class="card-more" aria-label="Read {{ post.data.title }}">Read article <span class="arr">→</span></a>
  </div>
</article>
